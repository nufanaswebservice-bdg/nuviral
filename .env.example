# ============================================
# ViralAI - Environment Configuration
# ============================================

# Application
NODE_ENV=development
APP_NAME=ViralAI
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
APP_PORT=4000
APP_SECRET=your-app-secret-key-change-this

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/viralai?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=your-jwt-secret-key-change-this
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth (Login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# YouTube API
YOUTUBE_CLIENT_ID=PASTE_YOUR_YOUTUBE_CLIENT_ID_HERE
YOUTUBE_CLIENT_SECRET=PASTE_YOUR_YOUTUBE_CLIENT_SECRET_HERE
YOUTUBE_REDIRECT_URI=http://localhost:4000/api/v1/social-accounts/youtube/callback

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@viralai.com

# Storage
STORAGE_TYPE=local
STORAGE_PATH=./uploads
AWS_S3_BUCKET=viralai-assets
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret

# CDN
CDN_URL=https://cdn.viralai.com

# FFmpeg
FFMPEG_PATH=/usr/bin/ffmpeg
FFMPEG_THREADS=4
MAX_RENDER_CONCURRENT=3

# TikTok API
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# YouTube API
YOUTUBE_CLIENT_ID=your-youtube-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret

# Instagram API
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret

# Facebook API
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Midtrans Payment
MIDTRANS_SERVER_KEY=Mid-server-xxxxx
MIDTRANS_CLIENT_KEY=Mid-client-xxxxx
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_MERCHANT_ID=G991189598

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn

# Analytics
MIXPANEL_TOKEN=your-mixpanel-token
