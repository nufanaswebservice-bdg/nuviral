// ============================================
// ViralAI - Database Schema
// Enterprise-grade PostgreSQL Schema
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTH & USERS
// ============================================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  password          String?
  name              String
  avatar            String?
  role              UserRole  @default(USER)
  emailVerified     Boolean   @default(false)
  emailVerifyToken  String?
  resetPasswordToken String?
  resetPasswordExpires DateTime?
  googleId          String?   @unique
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  subscription      Subscription?
  projects          Project[]
  socialAccounts    SocialAccount[]
  notifications     Notification[]
  mediaAssets       MediaAsset[]
  aiJobs            AiJob[]
  billing           Billing[]
  logs              Log[]
  teamMemberships   TeamMember[]

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

// ============================================
// SUBSCRIPTIONS & BILLING
// ============================================

model Subscription {
  id                String             @id @default(cuid())
  userId            String             @unique
  plan              SubscriptionPlan   @default(FREE)
  status            SubscriptionStatus @default(ACTIVE)
  stripeCustomerId  String?
  stripeSubscriptionId String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  videoRenderLimit  Int                @default(5)
  videoRenderUsed   Int                @default(0)
  aiCreditsLimit    Int                @default(50)
  aiCreditsUsed     Int                @default(0)
  storageLimit      BigInt             @default(1073741824) // 1GB
  storageUsed       BigInt             @default(0)
  teamMemberLimit   Int                @default(1)
  apiAccessEnabled  Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  AGENCY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
  EXPIRED
}

model Billing {
  id              String        @id @default(cuid())
  userId          String
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("USD")
  status          BillingStatus @default(PENDING)
  stripePaymentId String?
  invoiceUrl      String?
  description     String?
  createdAt       DateTime      @default(now())

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("billing")
}

enum BillingStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ============================================
// PROJECTS
// ============================================

model Project {
  id          String        @id @default(cuid())
  userId      String
  name        String
  description String?
  niche       String?
  status      ProjectStatus @default(ACTIVE)
  settings    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiScripts   AiScript[]
  videos      GeneratedVideo[]
  schedules   Schedule[]

  @@map("projects")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

// ============================================
// AI SCRIPTS & CONTENT
// ============================================

model AiScript {
  id            String          @id @default(cuid())
  projectId     String
  title         String
  hook          String?
  script        String
  caption       String?
  cta           String?
  hashtags      String[]
  niche         String?
  tone          String?
  duration      Int?            // seconds
  viralScore    Float?
  status        ScriptStatus    @default(DRAFT)
  metadata      Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  videos        GeneratedVideo[]

  @@map("ai_scripts")
}

enum ScriptStatus {
  DRAFT
  APPROVED
  RENDERING
  COMPLETED
  ARCHIVED
}

// ============================================
// GENERATED VIDEOS
// ============================================

model GeneratedVideo {
  id              String        @id @default(cuid())
  projectId       String
  scriptId        String?
  title           String
  description     String?
  filePath        String?
  thumbnailPath   String?
  duration        Int?          // seconds
  resolution      String?       @default("1080x1920")
  fileSize        BigInt?
  format          String?       @default("mp4")
  status          VideoStatus   @default(PENDING)
  renderProgress  Int           @default(0)
  templateId      String?
  settings        Json?
  errorMessage    String?
  renderedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  script          AiScript?     @relation(fields: [scriptId], references: [id])
  template        Template?     @relation(fields: [templateId], references: [id])
  uploadQueue     UploadQueue[]
  analytics       Analytics[]

  @@map("generated_videos")
}

enum VideoStatus {
  PENDING
  QUEUED
  RENDERING
  COMPLETED
  FAILED
  CANCELLED
}

// ============================================
// UPLOAD QUEUE
// ============================================

model UploadQueue {
  id              String          @id @default(cuid())
  videoId         String
  socialAccountId String
  platform        Platform
  status          UploadStatus    @default(PENDING)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  platformPostId  String?
  caption         String?
  hashtags        String[]
  retryCount      Int             @default(0)
  maxRetries      Int             @default(3)
  errorMessage    String?
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  video           GeneratedVideo  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount   @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@map("upload_queue")
}

enum UploadStatus {
  PENDING
  SCHEDULED
  UPLOADING
  PUBLISHED
  FAILED
  CANCELLED
  DRAFT
}

// ============================================
// SOCIAL ACCOUNTS
// ============================================

model SocialAccount {
  id              String        @id @default(cuid())
  userId          String
  platform        Platform
  platformUserId  String?
  username        String?
  displayName     String?
  avatar          String?
  accessToken     String?
  refreshToken    String?
  tokenExpiresAt  DateTime?
  isActive        Boolean       @default(true)
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploadQueue     UploadQueue[]
  analytics       Analytics[]

  @@unique([userId, platform, platformUserId])
  @@map("social_accounts")
}

enum Platform {
  TIKTOK
  YOUTUBE_SHORTS
  INSTAGRAM_REELS
  FACEBOOK_REELS
}

// ============================================
// ANALYTICS
// ============================================

model Analytics {
  id              String        @id @default(cuid())
  videoId         String?
  socialAccountId String?
  platform        Platform
  views           Int           @default(0)
  likes           Int           @default(0)
  comments        Int           @default(0)
  shares          Int           @default(0)
  saves           Int           @default(0)
  watchTime       Float?        // average seconds
  engagementRate  Float?
  ctr             Float?
  audienceRetention Float?
  viralScore      Float?
  reachCount      Int           @default(0)
  impressions     Int           @default(0)
  followers       Int           @default(0)
  recordedAt      DateTime      @default(now())
  metadata        Json?

  video           GeneratedVideo? @relation(fields: [videoId], references: [id], onDelete: SetNull)
  socialAccount   SocialAccount?  @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)

  @@map("analytics")
}

// ============================================
// SCHEDULES
// ============================================

model Schedule {
  id            String          @id @default(cuid())
  projectId     String
  title         String?
  scheduledAt   DateTime
  platform      Platform
  status        ScheduleStatus  @default(PENDING)
  recurrence    String?         // cron expression
  metadata      Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("schedules")
}

enum ScheduleStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// ============================================
// HASHTAGS
// ============================================

model Hashtag {
  id            String    @id @default(cuid())
  tag           String    @unique
  platform      Platform?
  category      String?
  usageCount    BigInt    @default(0)
  trendScore    Float?
  isViral       Boolean   @default(false)
  lastUpdated   DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@map("hashtags")
}

// ============================================
// TEMPLATES
// ============================================

model Template {
  id            String          @id @default(cuid())
  name          String
  description   String?
  category      String?
  thumbnail     String?
  config        Json
  isPublic      Boolean         @default(false)
  isPremium     Boolean         @default(false)
  usageCount    Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  videos        GeneratedVideo[]

  @@map("templates")
}

// ============================================
// MEDIA ASSETS
// ============================================

model MediaAsset {
  id            String        @id @default(cuid())
  userId        String
  name          String
  type          AssetType
  filePath      String
  fileSize      BigInt
  mimeType      String
  duration      Int?          // seconds for audio/video
  width         Int?
  height        Int?
  folderId      String?
  tags          String[]
  metadata      Json?
  createdAt     DateTime      @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder        MediaFolder?  @relation(fields: [folderId], references: [id])

  @@map("media_assets")
}

enum AssetType {
  IMAGE
  VIDEO
  AUDIO
  FONT
  OTHER
}

model MediaFolder {
  id            String        @id @default(cuid())
  name          String
  parentId      String?
  createdAt     DateTime      @default(now())

  parent        MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children      MediaFolder[] @relation("FolderTree")
  assets        MediaAsset[]

  @@map("media_folders")
}

// ============================================
// AI JOBS
// ============================================

model AiJob {
  id            String      @id @default(cuid())
  userId        String
  type          AiJobType
  status        JobStatus   @default(PENDING)
  input         Json
  output        Json?
  progress      Int         @default(0)
  errorMessage  String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime    @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_jobs")
}

enum AiJobType {
  SCRIPT_GENERATION
  HOOK_GENERATION
  CAPTION_GENERATION
  HASHTAG_GENERATION
  TITLE_GENERATION
  VIRAL_PREDICTION
  THUMBNAIL_GENERATION
  CONTENT_REWRITE
  TREND_ANALYSIS
  VIDEO_RENDER
  VOICE_GENERATION
  SUBTITLE_GENERATION
  TRANSLATION
}

enum JobStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id          String            @id @default(cuid())
  userId      String
  title       String
  message     String
  type        NotificationType
  isRead      Boolean           @default(false)
  actionUrl   String?
  metadata    Json?
  createdAt   DateTime          @default(now())

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  RENDER_COMPLETE
  UPLOAD_COMPLETE
  UPLOAD_FAILED
  SUBSCRIPTION
  SYSTEM
}

// ============================================
// LOGS
// ============================================

model Log {
  id          String    @id @default(cuid())
  userId      String?
  action      String
  resource    String?
  resourceId  String?
  details     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("logs")
}

// ============================================
// TEAM
// ============================================

model TeamMember {
  id          String      @id @default(cuid())
  userId      String
  teamOwnerId String
  role        TeamRole    @default(MEMBER)
  invitedAt   DateTime    @default(now())
  acceptedAt  DateTime?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, teamOwnerId])
  @@map("team_members")
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}


// ============================================
// ADVANCED AI VIDEO GENERATOR
// ============================================

model UploadedImage {
  id              String    @id @default(cuid())
  userId          String
  projectId       String?
  filePath        String
  fileName        String
  fileSize        BigInt
  mimeType        String
  width           Int?
  height          Int?
  order           Int       @default(0)
  analysis        Json?     // AI visual analysis results
  createdAt       DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("uploaded_images")
}

model UploadedReferenceVideo {
  id              String    @id @default(cuid())
  userId          String
  projectId       String?
  filePath        String
  fileName        String
  fileSize        BigInt
  mimeType        String
  duration        Int?
  width           Int?
  height          Int?
  analysis        Json?     // AI style analysis results
  frames          String[]  // Extracted frame paths
  createdAt       DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("uploaded_reference_videos")
}

model AiVisualAnalysis {
  id              String    @id @default(cuid())
  userId          String
  sourceType      String    // 'image' | 'video'
  sourceId        String
  detectedStyle   String?
  detectedMood    String?
  dominantColors  String[]
  detectedObjects String[]
  videoEnergy     Float?
  viralScore      Float?
  audienceMatch   String?
  platformOptimization Json?
  suggestedMotion String?
  suggestedTransitions String[]
  createdAt       DateTime  @default(now())

  @@index([userId, sourceType])
  @@map("ai_visual_analysis")
}

model RenderJob {
  id              String      @id @default(cuid())
  userId          String
  videoId         String?
  status          JobStatus   @default(PENDING)
  progress        Int         @default(0)
  currentStep     String?
  totalSteps      Int         @default(10)
  settings        Json
  inputData       Json?
  outputPath      String?
  thumbnailPath   String?
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime    @default(now())

  @@index([userId, status])
  @@map("render_jobs")
}

model RenderHistory {
  id              String    @id @default(cuid())
  userId          String
  renderJobId     String
  videoTitle      String
  templateUsed    String?
  styleUsed       String?
  duration        Int?
  resolution      String?
  fileSize        BigInt?
  renderTime      Int?      // seconds to render
  createdAt       DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("render_history")
}

model GeneratedStoryboard {
  id              String    @id @default(cuid())
  userId          String
  projectId       String?
  scriptId        String?
  scenes          Json      // Array of scene objects
  totalDuration   Int?
  style           String?
  status          String    @default("draft")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("generated_storyboards")
}

model VideoStyle {
  id              String    @id @default(cuid())
  name            String
  description     String?
  category        String?
  config          Json      // Style configuration
  previewUrl      String?
  isPublic        Boolean   @default(true)
  isPremium       Boolean   @default(false)
  usageCount      Int       @default(0)
  createdAt       DateTime  @default(now())

  @@map("video_styles")
}
